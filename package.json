{
  "name": "night-shift",
  "description": "A headless, cross-platform engine for durable agentic workflows.",
  "private": true,
  "engines": {
    "node": ">=22.19.0 <23",
    "pnpm": "^9.15.4"
  },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "turbo run build",
    "dev:authority-prototype": "pnpm --filter @night-shift/convex dev",
    "dev:worker": "node scripts/dev-worker.mjs",
    "format": "turbo run format --continue",
    "format:fix": "turbo run format:fix --continue",
    "lint": "turbo run lint --continue",
    "night-shift": "pnpm --filter @night-shift/cli start --",
    "test": "turbo run test --continue",
    "typecheck": "turbo run typecheck --continue"
  },
  "devDependencies": {
    "@night-shift/prettier-config": "workspace:*",
    "prettier": "catalog:",
    "turbo": "^2.5.8",
    "typescript": "catalog:"
  },
  "prettier": "@night-shift/prettier-config"
}
