{
  "lsp": {
    "vtsls": {
      "settings": {
        "typescript": {
          "tsdk": "./node_modules/typescript/lib",
          "tsserver": {
            "pluginPaths": ["./node_modules/.pnpm/node_modules"]
          }
        },
        "vtsls": {
          "autoUseWorkspaceTsdk": true,
          "tsserver": {
            "globalPlugins": [
              {
                "enableForWorkspaceTypeScriptVersions": true,
                "name": "@night-shift/effect-react-compiler"
              }
            ]
          }
        }
      }
    }
  }
}
