{
  "name": "@night-shift/effect-react-compiler",
  "private": true,
  "type": "module",
  "types": "./dist/index.d.ts",
  "main": "./dist/typescript-plugin.cjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/typescript-plugin.cjs"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    },
    "./virtual": {
      "types": "./src/virtual.d.ts"
    }
  },
  "bin": {
    "effect-react-tsc": "./dist/check.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && esbuild src/typescript-plugin.cts --bundle --platform=node --format=cjs --external:typescript --outfile=dist/typescript-plugin.cjs",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "format:fix": "prettier --write . --ignore-path ../../.gitignore",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@night-shift/eslint-config": "workspace:*",
    "@night-shift/prettier-config": "workspace:*",
    "@night-shift/tsconfig": "workspace:*",
    "@types/babel__core": "^7.20.5",
    "@types/node": "catalog:",
    "babel-plugin-react-compiler": "^1.0.0",
    "esbuild": "^0.25.12",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "^4.0.17"
  },
  "prettier": "@night-shift/prettier-config"
}
