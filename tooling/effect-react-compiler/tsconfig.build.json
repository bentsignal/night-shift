{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": false,
    "outDir": "dist",
    "rewriteRelativeImportExtensions": true,
    "rootDir": "src",
    "sourceMap": true
  },
  "include": ["src"],
  "exclude": ["test", "node_modules", "dist", "src/typescript-plugin.cts"]
}
