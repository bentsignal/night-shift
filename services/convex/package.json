{
  "name": "@code/convex",
  "private": true,
  "type": "module",
  "exports": {
    "./api": {
      "types": "./src/_generated/api.d.ts",
      "default": "./src/_generated/api.js"
    },
    "./domain": "./src/domain.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "dev": "convex dev",
    "deploy": "convex deploy",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "format:fix": "prettier --write . --ignore-path ../../.gitignore",
    "lint": "eslint",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "convex": "catalog:"
  },
  "devDependencies": {
    "@code/eslint-config": "workspace:*",
    "@code/prettier-config": "workspace:*",
    "@code/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest": "^4.0.17"
  },
  "prettier": "@code/prettier-config"
}
