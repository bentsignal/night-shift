{
  "name": "@code/worker",
  "version": "0.1.0",
  "description": "Host-local execution worker for the Code control plane.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "format:fix": "prettier --write . --ignore-path ../../.gitignore",
    "lint": "eslint",
    "smoke:codex": "node --experimental-strip-types src/smoke-codex.ts",
    "start": "node --experimental-strip-types src/main.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@effect/ai": "0.37.0",
    "@effect/ai-anthropic": "0.27.0",
    "@effect/ai-openai": "0.41.0",
    "@effect/experimental": "0.61.0",
    "@effect/platform": "0.97.0",
    "@effect/rpc": "0.76.0",
    "convex": "catalog:",
    "effect": "3.22.0"
  },
  "devDependencies": {
    "@code/eslint-config": "workspace:*",
    "@code/prettier-config": "workspace:*",
    "@code/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest": "^4.0.17"
  },
  "prettier": "@code/prettier-config"
}
