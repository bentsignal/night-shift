{
  "extends": "@night-shift/tsconfig/base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "plugins": [{ "name": "@night-shift/effect-react-compiler" }],
    "paths": {
      "~/*": ["./src/*"]
    },
    "types": ["vite/client", "@night-shift/effect-react-compiler/virtual"]
  },
  "include": ["src", "vite.config.ts", "vitest.config.ts", "eslint.config.ts"],
  "exclude": ["node_modules", "dist", ".output"]
}
