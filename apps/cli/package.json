{
  "name": "@code/cli",
  "version": "0.1.0",
  "description": "Local command-line client for the Code control plane.",
  "private": true,
  "type": "module",
  "bin": {
    "code-control": "./src/index.ts"
  },
  "scripts": {
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "format:fix": "prettier --write . --ignore-path ../../.gitignore",
    "lint": "eslint",
    "start": "node --experimental-strip-types src/index.ts",
    "test": "node --experimental-strip-types --test src/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@code/eslint-config": "workspace:*",
    "@code/prettier-config": "workspace:*",
    "@code/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:"
  },
  "prettier": "@code/prettier-config"
}
